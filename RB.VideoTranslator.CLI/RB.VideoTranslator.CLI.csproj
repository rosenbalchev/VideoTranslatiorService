<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RB.VideoTranslator.CLI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.*-*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RB.VideoTranslator.Core\RB.VideoTranslator.Core.csproj" />
    <ProjectReference Include="..\RB.VideoTranslator.Domain\RB.VideoTranslator.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- RB.VideoTranslator.NpuTranscriber (Intel/Qualcomm/AMD NPU support via Windows ML) can't be
       a normal <ProjectReference> — it targets net10.0-windows10.0.19041.0, which this plain
       net10.0 project (kept cross-platform-buildable, see RB.VideoTranslator.Core.csproj) can't
       reference directly. Build it explicitly and copy its output into npu-transcriber\ instead —
       WhisperOnnxTranscriberService.cs looks for it at exactly that path relative to this app's
       own output, and it must stay in its own subfolder (not merged into this output directory)
       since its Windows ML package bundles a differently-flavored onnxruntime.dll under the same
       filename as the one this app uses. Windows-only: skipped entirely elsewhere, matching how
       NPU acceleration itself is a Windows ML/Windows-only feature. -->
  <Target Name="BuildAndCopyNpuTranscriber" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <NpuTranscriberProject>$(MSBuildThisFileDirectory)..\RB.VideoTranslator.NpuTranscriber\RB.VideoTranslator.NpuTranscriber.csproj</NpuTranscriberProject>
      <NpuTranscriberOutDir>$(MSBuildThisFileDirectory)..\RB.VideoTranslator.NpuTranscriber\bin\$(Configuration)\net10.0-windows10.0.19041.0\</NpuTranscriberOutDir>
    </PropertyGroup>
    <MSBuild Projects="$(NpuTranscriberProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <NpuTranscriberOutput Include="$(NpuTranscriberOutDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(NpuTranscriberOutput)"
          DestinationFolder="$(OutDir)npu-transcriber\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
